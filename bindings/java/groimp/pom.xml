<?xml version="1.0" encoding="UTF-8"?>
<!-- GroIMP's adapter for fspm-TF: a GroIMP graph (de.grogra.graph.impl.Node) as an fspm-TF graph, and back. It builds on
     GroIMP's Graph module only (scales from refinement edges, managed fields as variables), so that it can become a
     GroIMP plugin (devplan_bindings.md, G4).

       mvn -f bindings/java/pom.xml install && mvn -f bindings/java/groimp/pom.xml verify
     (GroIMP's graph, utilities and xl.core 3.0.0 in the local repository: mvn -pl Graph -am install in GroIMP)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.openalea</groupId>
  <artifactId>fspm-tf-groimp</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>fspm-TF, GroIMP's adapter</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <groimp.version>3.0.0</groimp.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openalea</groupId>
      <artifactId>fspm-tf</artifactId>
      <version>0.1.0</version>
    </dependency>
    <dependency>
      <groupId>de.grogra</groupId>
      <artifactId>graph</artifactId>
      <version>${groimp.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <systemPropertyVariables>
            <fspmtf.conformance>${project.basedir}/../../../conformance</fspmtf.conformance>
            <fspmtf.out>${project.build.directory}/groimp_out</fspmtf.out>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
