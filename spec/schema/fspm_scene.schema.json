{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/openalea/encoding3d/schema/0.4/fspm_scene.schema.json",
 "title": "FSPM_scene",
 "description": "The FSPM_scene root extension of a glTF 2.0 asset (encoding3d 0.4): one frame of a scene, or a shared part (part).",
 "type": "object",
 "required": ["version", "frame", "dataStructures"],
 "properties": {
  "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
  "vocabulary": {"type": "string"},
  "frame": {
   "type": "object", "required": ["time", "timeUnit", "step"],
   "properties": {"time": {"type": "number"}, "timeUnit": {"type": "string", "minLength": 1},
                  "step": {"type": "integer", "minimum": 0}},
   "additionalProperties": false},
  "writer": {"type": "object"},
  "update": {
   "description": "Set in a partial frame, a coupling session's message (specification §11): its sender, and the entities it removed.",
   "type": "object", "required": ["participant"],
   "properties": {
    "participant": {"$ref": "#/$defs/identifier"},
    "removed": {"type": "array", "items": {
     "type": "object", "required": ["dataStructure", "entitySet", "propertyTable"],
     "properties": {"dataStructure": {"$ref": "#/$defs/identifier"}, "entitySet": {"type": "string", "minLength": 1},
                    "propertyTable": {"$ref": "#/$defs/index"}},
     "additionalProperties": false}}
   },
   "additionalProperties": false
  },
  "part": {"$ref": "#/$defs/part"},
  "parts": {
   "description": "Shared parts embedded in this frame (specification §12.1): each key and the buffer view holding the part's GLB bytes.",
   "type": "object", "propertyNames": {"$ref": "#/$defs/key"},
   "additionalProperties": {"type": "object", "required": ["bufferView"],
                            "properties": {"bufferView": {"$ref": "#/$defs/index"}}, "additionalProperties": false}},
  "dataStructures": {"type": "array", "items": {"$ref": "#/$defs/dataStructure"}},
  "mappings": {"type": "array", "items": {"$ref": "#/$defs/mapping"}},
  "variables": {
   "type": "object",
   "propertyNames": {"$ref": "#/$defs/identifier"},
   "additionalProperties": {"type": "object", "propertyNames": {"$ref": "#/$defs/identifier"},
                            "additionalProperties": {"$ref": "#/$defs/variable"}}},
  "extensions": {"type": "object"},
  "extras": {}
 },
 "additionalProperties": false,
 "$defs": {
  "identifier": {"type": "string", "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"},
  "key": {"description": "A shared part's content key: the SHA-256 of its GLB bytes, lower-case hexadecimal.",
          "type": "string", "pattern": "^[0-9a-f]{64}$"},
  "sparse": {"type": "object", "required": ["indptr", "indices", "values"],
             "properties": {"indptr": {"$ref": "#/$defs/index"}, "indices": {"$ref": "#/$defs/index"},
                            "values": {"$ref": "#/$defs/index"}}},
  "part": {
   "description": "This file is a shared part (specification §12.1): a template (its one data structure, its meshes and entity sets) or an operator (its arrays: buffer views of float64 values and int64 indices).",
   "type": "object", "required": ["kind"],
   "properties": {
    "kind": {"enum": ["template", "operator"]},
    "format": {"enum": ["dense", "csr", "solve"]},
    "rows": {"type": "integer", "minimum": 0}, "columns": {"type": "integer", "minimum": 0},
    "values": {"$ref": "#/$defs/index"}, "indptr": {"$ref": "#/$defs/index"}, "indices": {"$ref": "#/$defs/index"},
    "system": {"$ref": "#/$defs/sparse"}, "rightHandSide": {"$ref": "#/$defs/sparse"}},
   "additionalProperties": false,
   "allOf": [
    {"if": {"properties": {"kind": {"const": "operator"}}}, "then": {"required": ["format", "rows", "columns"]},
     "else": {"not": {"anyOf": [{"required": ["format"]}, {"required": ["rows"]}, {"required": ["columns"]}]}}},
    {"if": {"required": ["format"], "properties": {"format": {"const": "dense"}}}, "then": {"required": ["values"]}},
    {"if": {"required": ["format"], "properties": {"format": {"const": "csr"}}}, "then": {"required": ["indptr", "indices", "values"]}},
    {"if": {"required": ["format"], "properties": {"format": {"const": "solve"}}}, "then": {"required": ["system", "rightHandSide"]}}]},
  "instanceSet": {
   "description": "Instances of shared templates (specification §12.2): their table (template, owner, transform, id, their own variables, each vector's <name>__count, each derived field's <name>__operator and <name>__weight), their vectors' tables, their derived fields.",
   "type": "object", "required": ["name", "propertyTable", "parts"],
   "properties": {
    "name": {"$ref": "#/$defs/identifier"},
    "propertyTable": {"$ref": "#/$defs/index"},
    "owners": {"$ref": "#/$defs/identifier"},
    "parts": {"type": "array", "items": {"$ref": "#/$defs/key"}},
    "vectors": {"type": "array", "items": {
     "type": "object", "required": ["name", "propertyTable"],
     "properties": {"name": {"$ref": "#/$defs/identifier"}, "propertyTable": {"$ref": "#/$defs/index"}},
     "additionalProperties": false}},
    "derivedFields": {"type": "array", "items": {
     "type": "object", "required": ["name", "entitySet", "input", "terms"],
     "properties": {"name": {"$ref": "#/$defs/identifier"}, "entitySet": {"$ref": "#/$defs/identifier"},
                    "input": {"$ref": "#/$defs/identifier"}, "terms": {"type": "integer", "minimum": 1},
                    "offsets": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}},
                    "description": {"type": "string"},
                    "variable": {"$ref": "#/$defs/variable"}},
     "additionalProperties": false}}},
   "additionalProperties": false},
  "index": {"type": "integer", "minimum": 0},
  "dataStructure": {
   "type": "object", "required": ["id", "kind", "origin", "node", "entitySets"],
   "properties": {
    "id": {"$ref": "#/$defs/identifier"},
    "kind": {"enum": ["graph", "regular_grid", "adaptive_grid", "table"]},
    "platform": {"type": "string"}, "model": {"type": "string"},
    "origin": {"type": "array", "items": {"type": "number"}, "minItems": 16, "maxItems": 16},
    "node": {"$ref": "#/$defs/index"},
    "entitySets": {"type": "array", "items": {
     "type": "object", "required": ["name", "propertyTable"],
     "properties": {"name": {"$ref": "#/$defs/identifier"}, "rank": {"type": ["integer", "null"]},
                    "scale": {"enum": ["Plant", "Axis", "GrowthUnit", "Phytomer", "Organ", "SubOrgan", "Layer",
                                       "Cell", "Compartment", "Connection", "mixed"]},
                    "propertyTable": {"$ref": "#/$defs/index"}},
     "additionalProperties": false}},
    "relations": {"type": "array", "items": {
     "type": "object", "required": ["name", "sourceSet", "targetSet", "propertyTable"],
     "properties": {"name": {"$ref": "#/$defs/identifier"}, "sourceSet": {"$ref": "#/$defs/identifier"},
                    "targetSet": {"$ref": "#/$defs/identifier"}, "propertyTable": {"$ref": "#/$defs/index"}},
     "additionalProperties": false}},
    "scalars": {"$ref": "#/$defs/index"},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "grid": {"$ref": "#/$defs/grid"},
    "extras": {"type": "object"},
    "meshes": {"type": "array", "items": {
     "type": "object", "required": ["name", "mesh"],
     "properties": {"name": {"type": "string"}, "mesh": {"$ref": "#/$defs/index"},
                    "display": {"type": "array", "items": {
                     "type": "object", "required": ["attribute", "variable"],
                     "properties": {"attribute": {"type": "string", "pattern": "^_"},
                                    "variable": {"$ref": "#/$defs/identifier"},
                                    "entitySet": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]}},
                     "additionalProperties": false}}},
     "additionalProperties": false}},
    "instanceSets": {"type": "array", "items": {"$ref": "#/$defs/instanceSet"}}
   },
   "additionalProperties": false},
  "grid": {
   "type": "object", "required": ["kind", "shape", "origin", "spacing", "axes", "periodic", "zUp", "cells"],
   "properties": {
    "kind": {"enum": ["regular", "adaptive"]},
    "shape": {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 1},
    "origin": {"type": "array", "items": {"type": "number"}},
    "spacing": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}},
    "axes": {"type": "array", "items": {"type": "string"}},
    "periodic": {"type": "array", "items": {"type": "boolean"}},
    "zUp": {"type": "boolean"},
    "maxLevel": {"type": "integer", "minimum": 0},
    "cells": {"$ref": "#/$defs/identifier"}},
   "additionalProperties": false},
  "mapping": {
   "type": "object", "required": ["name", "source", "target", "propertyTable"],
   "properties": {
    "name": {"$ref": "#/$defs/identifier"},
    "source": {"$ref": "#/$defs/end"}, "target": {"$ref": "#/$defs/end"},
    "method": {"type": "string"}, "propertyTable": {"$ref": "#/$defs/index"}},
   "additionalProperties": false},
  "end": {
   "type": "object", "required": ["dataStructure", "entitySet"],
   "properties": {"dataStructure": {"$ref": "#/$defs/identifier"}, "entitySet": {"$ref": "#/$defs/identifier"}},
   "additionalProperties": false},
  "variable": {
   "type": "object", "required": ["unit", "role"],
   "properties": {
    "unit": {"type": "string", "minLength": 1},
    "standardName": {"type": "string"},
    "kind": {"enum": ["extensive", "intensive", "massic_concentration", "volumic_concentration", "descriptor"]},
    "role": {"enum": ["state", "input", "parameter", "derived", "setting"]},
    "minimum": {"type": "number"}, "maximum": {"type": "number"},
    "references": {"type": "array", "items": {"type": "string"}},
    "doi": {"type": "array", "items": {"type": "string"}},
    "format": {"enum": ["date", "date-time", "time"]}},
   "additionalProperties": false}
 }
}
